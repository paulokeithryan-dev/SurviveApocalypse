-- Melee Kill Aura Loop
task.spawn(function()
    while task.wait(0.1) do
        if Settings.KillAuraEnabled and LocalPlayer.Character then
            local char = LocalPlayer.Character
            local tool = char:FindFirstChildOfClass("Tool")
            
            if tool then
                local swingRemote = tool:FindFirstChild("Swing")
                local hitRemote = tool:FindFirstChild("HitTargets")

                if swingRemote and hitRemote then
                    local myPos = getLocalRootPosition()
                    local targetsToHit = {}
                    local charsFolder = Workspace:FindFirstChild("Characters")

                    if charsFolder then
                        for _, enemy in ipairs(charsFolder:GetChildren()) do
                            if isZombieEnemy(enemy) and canBeDamaged(enemy) then
                                local part = getTargetPart(enemy)
                                if part and (part.Position - myPos).Magnitude <= Settings.KillAuraRange then
                                    table.insert(targetsToHit, enemy)
                                end
                            end
                        end
                    end

                    if #targetsToHit > 0 then
                        swingRemote:FireServer()
                        hitRemote:FireServer(targetsToHit)
                    end
                end
            end
        end
    end
end)

-- Auto Target Broadcaster Loop
task.spawn(function()
    while task.wait(1) do
        if LocalPlayer.Character then
            local autoTarget = LocalPlayer.Character:FindFirstChild("AutoTargetClient")
            if autoTarget and autoTarget:FindFirstChild("UpdateNearbyTargets") then
                local charsFolder = Workspace:FindFirstChild("Characters")
                if charsFolder then
                    pcall(function()
                        autoTarget.UpdateNearbyTargets:FireServer(charsFolder:GetChildren())
                    end)
                end
            end
        end
    end
end)

-- Instant Reload Watcher
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if InstantReloadEnabled and input.KeyCode == Enum.KeyCode.R then
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then
            TriggerRemoteReload(tool)
        end
    end
end)

-- Aimlock Loop
RunService.RenderStepped:Connect(function()
    if FOVCircle then
        FOVCircle.Position = UserInputService:GetMouseLocation()
    end

    if Settings.AimlockEnabled and isAiming then
        if not lockedTarget or not lockedTarget.Parent or not canBeDamaged(lockedTarget.Parent) then
            lockedTarget = getClosestZombie()
        end

        if lockedTarget then
            local targetPos = lockedTarget.Position
            if Settings.AimMethod == "Camera" then
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, Settings.Smoothness)
            elseif Settings.AimMethod == "MouseRel" then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local moveX = (screenPos.X - mousePos.X) * Settings.Smoothness
                    local moveY = (screenPos.Y - mousePos.Y) * Settings.Smoothness
                    mousemoverel(moveX, moveY)
                end
            end
        end
    end
end)
