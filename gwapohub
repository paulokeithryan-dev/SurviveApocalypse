local function GetItemTypeColor(itemName)
    local lower = itemName:lower()
    if lower:find("gun") or lower:find("rifle") or lower:find("pistol") or lower:find("ammo") or lower:find("weapon") or lower:find("shotgun") or lower:find("smg") then
        return Color3.fromRGB(255, 85, 85)
    elseif lower:find("med") or lower:find("bandage") or lower:find("heal") or lower:find("food") or lower:find("drink") or lower:find("blood") then
        return Color3.fromRGB(85, 255, 85)
    elseif lower:find("armor") or lower:find("helmet") or lower:find("vest") or lower:find("shield") then
        return Color3.fromRGB(85, 170, 255)
    elseif lower:find("card") or lower:find("key") or lower:find("gold") or lower:find("chip") or lower:find("coin") or lower:find("cash") then
        return Color3.fromRGB(220, 100, 255)
    end
    return Color3.fromRGB(255, 255, 150)
end

local function CreateOrUpdateDotESP(targetInstance, espTag, customName, color)
    if not targetInstance then return end

    local adorneePart = nil
    if targetInstance:IsA("BasePart") then
        adorneePart = targetInstance
    elseif targetInstance:IsA("Model") then
        adorneePart = targetInstance.PrimaryPart or targetInstance:FindFirstChildOfClass("BasePart") or targetInstance:FindFirstChild("Head", true) or targetInstance:FindFirstChild("HumanoidRootPart", true)
    end

    if not adorneePart then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local distanceText = ""
    if hrp then
        local dist = math.floor((hrp.Position - adorneePart.Position).Magnitude)
        distanceText = string.format(" [%dm]", dist)
    end

    local displayName = (customName or targetInstance.Name) .. distanceText

    local existingGui = adorneePart:FindFirstChild(espTag)
    if existingGui then
        local label = existingGui:FindFirstChildOfClass("TextLabel")
        if label then
            label.Text = displayName
        end
        return
    end

    local gui = Instance.new("BillboardGui")
    gui.Name = espTag
    gui.Adornee = adorneePart
    gui.Size = UDim2.new(0, 200, 0, 50)
    gui.StudsOffset = Vector3.new(0, 2, 0)
    gui.AlwaysOnTop = true
    gui.Parent = adorneePart

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 8, 0, 8)
    dot.Position = UDim2.new(0.5, -4, 0.5, -4)
    dot.BackgroundColor3 = color or Color3.fromRGB(255, 255, 255)
    dot.BorderSizePixel = 0
    dot.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = dot

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.Position = UDim2.new(0, 0, 0, -20)
    label.BackgroundTransparency = 1
    label.Text = displayName
    label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextSize = 13
    label.Font = Enum.Font.SourceSansBold
    label.Parent = gui
end

local function RemoveDotESP(parentFolder, espTag)
    if not parentFolder then return end
    for _, item in ipairs(parentFolder:GetChildren()) do
        for _, desc in ipairs(item:GetDescendants()) do
            if desc:IsA("BillboardGui") and desc.Name == espTag then
                desc:Destroy()
            end
        end
    end
end

