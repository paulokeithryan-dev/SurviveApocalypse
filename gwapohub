local InstantPromptsEnabled = false
local PromptConnection = nil
local originalHoldDurations = {}

local function makeInstant(prompt)
    if prompt:IsA("ProximityPrompt") then
        if originalHoldDurations[prompt] == nil then
            originalHoldDurations[prompt] = prompt.HoldDuration
        end
        prompt.HoldDuration = 0
    end
end

MiscTab:CreateToggle({
    Name = "Instant Proximity Prompts",
    CurrentValue = false,
    Flag = "InstantPromptsToggle",
    Callback = function(Value)
        InstantPromptsEnabled = Value
        if InstantPromptsEnabled then
            for _, descendant in ipairs(Workspace:GetDescendants()) do
                makeInstant(descendant)
            end
            if not PromptConnection then
                PromptConnection = Workspace.DescendantAdded:Connect(function(descendant)
                    if InstantPromptsEnabled then
                        makeInstant(descendant)
                    end
                end)
            end
        else
            if PromptConnection then
                PromptConnection:Disconnect()
                PromptConnection = nil
            end
            for prompt, origDuration in pairs(originalHoldDurations) do
                if prompt and prompt.Parent then
                    prompt.HoldDuration = origDuration
                end
            end
        end
    end,
})

