-- INSTANT RELOAD & REMOTE RELOAD / SYNC AMMO
local InstantReloadEnabled = false

local function ApplyInstantReload(tool)
    if not tool or not tool:IsA("Tool") then return end
    
    -- Zero out reload attributes
    for _, attr in ipairs({"ReloadTime", "ReloadDuration", "ReloadSpeed", "ReloadDelay", "Cooldown"}) do
        if tool:GetAttribute(attr) ~= nil then
            tool:SetAttribute(attr, 0)
        end
    end

    -- Zero out Value instances inside the tool
    for _, desc in ipairs(tool:GetDescendants()) do
        if desc:IsA("ValueBase") then
            local name = desc.Name:lower()
            if name:find("reloadtime") or name:find("reloaddelay") or name:find("reloadspeed") then
                if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                    desc.Value = 0
                end
            elseif name:find("reloading") and desc:IsA("BoolValue") then
                desc.Value = false
            end
        end
    end
end

local function TriggerRemoteReload(tool)
    if not tool or not tool:IsA("Tool") then return end
    
    local reloadRemote = tool:FindFirstChild("Reload")
    local syncRemote = tool:FindFirstChild("SyncAmmo")

    if reloadRemote and reloadRemote:IsA("RemoteFunction") then
        pcall(function() reloadRemote:InvokeServer() end)
    end
    if syncRemote and syncRemote:IsA("RemoteEvent") then
        pcall(function() syncRemote:FireServer() end)
    end
end

local function ProcessAllTools()
    local char = LocalPlayer.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then 
                ApplyInstantReload(item)
                if RemoteFastReloadEnabled then TriggerRemoteReload(item) end
            end
        end
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then 
                ApplyInstantReload(item) 
                if RemoteFastReloadEnabled then TriggerRemoteReload(item) end
            end
        end
    end
end

