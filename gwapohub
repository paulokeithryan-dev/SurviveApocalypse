local SelectedItemName = nil

local function GetGroupedItemNames()
    local counts = {}
    local droppedFolder = Workspace:FindFirstChild("DroppedItems")
    if droppedFolder then
        for _, item in ipairs(droppedFolder:GetChildren()) do
            counts[item.Name] = (counts[item.Name] or 0) + 1
        end
    end

    local options = {}
    for name, count in pairs(counts) do
        table.insert(options, string.format("%s x%d", name, count))
    end

    if #options == 0 then
        table.insert(options, "No items found")
    else
        table.sort(options)
    end
    return options
end

local ItemDropdown = ItemsTab:CreateDropdown({
    Name = "Select Target Item",
    Options = GetGroupedItemNames(),
    CurrentOption = {"No items found"},
    MultipleOptions = false,
    Flag = "ItemDropdown",
    Callback = function(Options)
        local rawOption = type(Options) == "table" and Options[1] or Options
        if rawOption and rawOption ~= "No items found" then
            SelectedItemName = rawOption:match("^(.-)%s*x%d+$") or rawOption
        else
            SelectedItemName = nil
        end
    end,
})

task.spawn(function()
    local lastSerialized = ""
    while task.wait(1) do
        local currentOptions = GetGroupedItemNames()
        local currentSerialized = table.concat(currentOptions, "|")
        if currentSerialized ~= lastSerialized then
            lastSerialized = currentSerialized
            ItemDropdown:Refresh(currentOptions)
        end
    end
end)

