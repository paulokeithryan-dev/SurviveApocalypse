-- INSTANT RELOAD & AMMO SYNC
local InstantReloadEnabled = false

local function TriggerRemoteReload(tool)
    if not tool or not tool:IsA("Tool") then return end
    
    local reloadRemote = tool:FindFirstChild("Reload")
    local syncAmmoRemote = tool:FindFirstChild("SyncAmmo")

    if reloadRemote and reloadRemote:IsA("RemoteFunction") then
        task.spawn(function()
            pcall(function() reloadRemote:InvokeServer() end)
        end)
    end

    if syncAmmoRemote and syncAmmoRemote:IsA("RemoteEvent") then
        task.spawn(function()
            pcall(function() syncAmmoRemote:FireServer() end)
        end)
    end
end

