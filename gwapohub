-- INPUT & RUNSERVICE LISTENERS FOR ZOMBIE AIMLOCK
--------------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if Settings.AimlockEnabled and input.UserInputType == Settings.Keybind then
        isAiming = true
        lockedTarget = getClosestZombie()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Settings.Keybind then
        isAiming = false
        lockedTarget = nil
    end
end)

RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()

    -- Update FOV Circle
    if FOVCircle then
        FOVCircle.Position = mousePos
        FOVCircle.Radius = Settings.FOVSize
        FOVCircle.Visible = Settings.ShowFOV and Settings.AimlockEnabled
    end

    if not Settings.AimlockEnabled or not isAiming or not UserInputService:IsMouseButtonPressed(Settings.Keybind) then
        lockedTarget = nil
        return
    end

    -- Aimlock Processing
    if lockedTarget and lockedTarget.Parent and canBeDamaged(lockedTarget.Parent) then
        local humanoid = lockedTarget.Parent:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            local targetScreenPos, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)

            if onScreen then
                if Settings.AimMethod == "MouseRel" and mousemoverel then
                    local deltaX = (targetScreenPos.X - mousePos.X) * Settings.Smoothness
                    local deltaY = (targetScreenPos.Y - mousePos.Y) * Settings.Smoothness
                    mousemoverel(deltaX, deltaY)
                else
                    local currentCFrame = Camera.CFrame
                    local targetCFrame = CFrame.new(currentCFrame.Position, lockedTarget.Position)
                    Camera.CFrame = currentCFrame:Lerp(targetCFrame, Settings.Smoothness)
                end
            end
        else
            lockedTarget = nil
        end
    else
        lockedTarget = nil
    end
end)

