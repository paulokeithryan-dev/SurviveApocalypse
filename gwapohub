                        if crateIndex then
                            local targetCrate = cratesFolder:GetChildren()[crateIndex]
                            if targetCrate then
                                CreateOrUpdateDotESP(targetCrate, "SelectedCrateESP", targetCrate.Name, Color3.fromRGB(255, 170, 0))
                            end
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end
    end,
})

